opam-version: "2.0"
name: "ocaml-cross-windows"
version: "5.3.0"
synopsis: "OCaml 5.3.0 cross compiler to Windows MinGW"
maintainer: "Samuel Hym <samuel@tarides.com>"
authors: "Xavier Leroy and many contributors"
license: "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://ocaml.org"
bug-reports: "https://github.com/ocaml/opam-repository/issues"
depends: [
  "ocaml" {= version}
  "ocamlfind"
  "flexdll" {>= "0.42"}
]
depopts: [
  "ocaml-option-afl"
  "ocaml-option-no-flat-float-array"
  "ocaml-option-flambda"
  "ocaml-option-fp"
  "ocaml-option-no-compression"
  "ocaml-option-static"
  "ocaml-option-tsan"
]
conflicts: ["ocaml-option-32bit" "ocaml-option-bytecode-only"]
build: [
  [
    "./configure"
    "--target=x86_64-w64-mingw32"
    "--prefix=%{_:lib}%"
    "--with-flexdll=%{flexdll:share}%"
    "--with-afl" {ocaml-option-afl:installed}
    "--disable-flat-float-array" {ocaml-option-no-flat-float-array:installed}
    "--enable-flambda" {ocaml-option-flambda:installed}
    "--enable-frame-pointers" {ocaml-option-fp:installed}
    "--without-zstd" {ocaml-option-no-compression:installed}
    "--enable-tsan" {ocaml-option-tsan:installed}
    "--disable-warn-error"
  ]
  [make "-j%{jobs}%" "crossopt"]
]
install: [
  [make "installcross"]
  [make "-f" "Makefile.ocamlfindconf" "%{lib}%/findlib.conf.d/%{name}%.conf"]
]
patches: ["ocross-squashed.patch" "ocamlfindconf.patch"]
dev-repo: "git+https://github.com/shym/ocaml.git#5.3+ocross"
url {
  src:
    "https://github.com/ocaml/ocaml/releases/download/5.3.0/ocaml-5.3.0.tar.gz"
  checksum:
    "sha256=22c1dd9de21bf43b62d1909041fb5fad648905227bf69550a6a6bef31e654f38"
}
extra-source "ocamlfindconf.patch" {
  src:
    "https://github.com/shym/ocaml/commit/842a25b0dc30137fd0ad2f3a18b13f6794a9a517.patch"
  checksum:
    "sha256=34c06921999a4e73533840cb33072297a1d0570b36462e547aca2094969f0f7f"
}
extra-source "ocross-squashed.patch" {
  src:
    "https://github.com/shym/ocaml/commit/1515ed9f7c8e2e7feb9864115b12040532a07230.patch"
  checksum:
    "sha256=709f9cdcff74a76d6884e43a3274799e509a980456555f15c7b1002b8392ff55"
}
